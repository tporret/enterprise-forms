{
  "$schema": "https://schemas.wp.org/wp/6.1/block.json",
  "apiVersion": 3,
  "name": "ep/file-upload",
  "version": "1.0.1",
  "title": "File Upload",
  "category": "enterprise-forms",
  "icon": "upload",
  "description": "Allow users to upload files directly to cloud storage with pre-signed URLs.",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Upload Files"
    },
    "name": {
      "type": "string",
      "default": "file_upload"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "acceptedFileTypes": {
      "type": "array",
      "default": [
        "pdf",
        "doc",
        "docx",
        "jpg",
        "png"
      ],
      "items": {
        "type": "string"
      }
    },
    "maxFileSize": {
      "type": "number",
      "default": 10485760,
      "description": "Max file size in bytes (default: 10MB)"
    },
    "multiple": {
      "type": "boolean",
      "default": false,
      "description": "Allow multiple file uploads"
    }
  },
  "supports": {
    "reusable": false,
    "html": false
  },
  "textdomain": "enterprise-forms"
}